<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}}</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 20px; }
    .error { color: red; }
    .success { color: green; }
    form { max-width: 400px; margin: auto; }
    label { display: block; margin: 10px 0 5px; }
    input { width: 100%; padding: 8px; margin-bottom: 10px; }
    button { padding: 10px 20px; background: #007BFF; color: #fff; border: none; cursor: pointer; }
    .go-back { font-size: 20px; text-decoration: none; color: #007BFF; margin-left: 10px; }
    .go-back:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <a href="{{backHref}}" class="go-back">&#8592; {{backTitle}}</a>

  <form method="POST" action="/auth/change-password">
    <h1 style="display: inline;">{{title}} mustache</h1>
    <label for="email">Email</label>
    <input type="email" name="email" id="email" required />

    <label for="oldPassword">Old Password</label>
    <input type="password" name="oldPassword" id="oldPassword" required />

    <label for="newPassword">New Password</label>
    <input type="password" name="newPassword" id="newPassword" required />

    <button type="submit">Change Password</button>

    {{#errors}}
      <ul class="error">
        <li>{{.}}</li>  <!-- Accessing each error -->
      </ul>
    {{/errors}}

    {{#success}}
      <p class="success">{{success}}</p>
    {{/success}}
  </form>
</body>
</html>
