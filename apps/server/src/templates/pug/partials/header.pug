doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title
    style.
      body { font-family: Arial, sans-serif; margin: 20px; }
      .error { color: red; }
      .success { color: green; }
      form { max-width: 400px; margin: auto; }
      label { display: block; margin: 10px 0 5px; }
      input { width: 100%; padding: 8px; margin-bottom: 10px; }
      button { padding: 10px 20px; background: #007BFF; color: #fff; border: none; cursor: pointer; }
      .go-back { font-size: 20px; text-decoration: none; color: #007BFF; margin-left: 10px; }
      .go-back:hover { text-decoration: underline; }
  body
    a(href=backHref, class="go-back") &#8592; 
      = backTitle