<%- include( header ) %>

    <form method="POST" action="/auth/change-settings">
      <h1><%= title %></h1>

      <label for="firstname">First Name</label>
      <input type="text" name="firstname" id="firstname" value="<%= user.firstname %>"  />

      <label for="lastname">Last Name</label>
      <input type="text" name="lastname" id="lastname" value="<%= user.lastname %>"  />

      <label for="email">Email</label>
      <input type="email" name="email" id="email" value="<%= user.email %>" disabled />
      <input type="hidden" name="email" id="email" value="<%= user.email %>" />

      <label for="newPassword">New Password</label>
      <input type="password" name="newPassword" id="newPassword" />

      <input type="hidden" name="authToken" id="authToken" value="<%= authToken %>" />
      <input type="hidden" name="backHref" id="backHref" value="<%= backHref %>" />

      <label for="profilePicture">Profile picture</label>
      <input type="text" name="profilePicture" id="profilePicture" value="<%= user.profilePicture %>" />
      
      <% if (user.profilePicture) { %>
        <label for="email">Profile picture</label>
        <img src="<%= user.profilePicture %>" alt="Profile Picture" id="profilePicturePreview" style="margin:auto;width:200px;height:200px;border-radius: 100px;object-fit: cover;"/>
      <% } %>

      <button type="submit">Save Changes</button>

      <% if (errors.length > 0) { %>
        <ul class="error">
          <% errors.forEach(error => { %>
            <li><%= error %></li>
          <% }); %>
        </ul>
      <% } %>

      <% if (success) { %>
        <p class="success"><%= success %></p>
      <% } %>
    </form>
  </body>
</html>
